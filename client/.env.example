# 复制成 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交

# 【dev 默认方案】留空即可。
# 留空时 src/api.ts 用相对路径 /api，由 vite dev server 代理到 VITE_PROXY_TARGET。
# 只有在想直连线上后端时才填，例：VITE_API_URL=https://your-backend.onrender.com/api
VITE_API_URL=

# vite dev server 把 /api 转发到哪里（只在本地开发生效，不打进构建产物）
# 要和 server/.env 里的 PORT 对上
VITE_PROXY_TARGET=http://localhost:5001
