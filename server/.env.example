# 复制成 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交

# MongoDB 连接串。可以直接用你线上 Atlas 的那一条（末尾记得带数据库名）
# 例：mongodb+srv://<user>:<password>@<cluster>.mongodb.net/graveyard?retryWrites=true&w=majority
MONGO_URI=

# JWT 签名密钥。本地随便一串长字符串即可，但必须和线上后端的值一致，
# 否则线上签发的 token 拿到本地会验签失败（反之亦然）
JWT_SECRET=

# 后端端口。5000 会被 macOS AirPlay 占用，本地用 5001
PORT=5001

# ── 照片上传（AWS S3）──────────────────────────────
# 桶所在区域，如 us-west-2
AWS_REGION=
# 专给本项目建的 IAM 用户的访问密钥（只有这个桶的权限）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 桶名
S3_BUCKET=
# 照片的公开访问地址前缀，末尾不带斜杠。
# 例：https://<桶名>.s3.<区域>.amazonaws.com
# 以后接 CloudFront 时只改这一个值
S3_PUBLIC_BASE_URL=
